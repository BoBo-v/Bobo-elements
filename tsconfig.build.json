{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitThis": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.css",
    "src/core/components/**/*",
    "src/hooks/**/*",
    "src/vue/**/*",
    "src/react/**/*"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/_tests__/**",
    "src/App.vue",
    "src/indexold.ts"
  ]
}
